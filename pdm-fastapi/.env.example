# Copy this file to .env.local for local runs.
# Keep real secrets and machine-only settings out of Git.

# Spring backend
SPRING_BASE_URL=http://localhost:8585
PDM_REQUEST_TIMEOUT_SECONDS=10
PDM_REQUEST_MAX_RETRIES=2
PDM_REQUEST_RETRY_BACKOFF_SECONDS=0.5

# Scheduler
PDM_SCHEDULER_AUTOSTART=true
PDM_ANALYSIS_INTERVAL_SECONDS=600

# Analysis window
PDM_ANALYSIS_WINDOW_MINUTES=60
PDM_FETCH_HISTORY_MINUTES=10000
PDM_BUCKET_MINUTES=10

# Preprocessing / models
PDM_EVENT_COUNT_MIN=10
PDM_WINDOW_SIZE=6

# cameraId:laneId,cameraId:laneId,...
PDM_TARGETS=1:1,2:1,3:3,4:3,5:5

# Duplicate-save guard
PDM_DEDUP_DB_PATH=outputs/pdm_dedup.sqlite3

# Spring contract mapping
PDM_COLLAPSE_HIGH_TO_CRITICAL=true
PDM_LSTM_WIRE_MODEL_TYPE=LSTM_AE
